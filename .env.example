# J.A.R.V.I.S. — Example env file
# Copy to .env and fill in your secrets. NEVER COMMIT real .env.

# === LLM Providers ===
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GIGACHAT_AUTH_KEY=

# === Telegram ===
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI...
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_OWNER_CHAT_ID=

# === External APIs ===
OPENWEATHER_API_KEY=
NEWSAPI_KEY=

# === Selectel (on-demand GPU) ===
SELECTEL_API_KEY=
SELECTEL_PROJECT_ID=

# === Runtime ===
JARVIS_ENV=development
JARVIS_LOG_LEVEL=INFO
JARVIS_OWNER_NAME=Boss
JARVIS_OWNER_ADDR=Boss

# === Infrastructure ===
REDIS_URL=redis://localhost:6379
SQLITE_PATH=./workspace/jarvis.db
WORKSPACE_DIR=./workspace
